<script></script>	<script>
	(function () {
		var LT_LOGO_MODAL_AUTO_CLOSE_DELAY = 6000;

		function ready(fn) {
			if (document.readyState !== 'loading') {
				fn();
			} else {
				document.addEventListener('DOMContentLoaded', fn);
			}
		}

		function addCacheBuster(url) {
			try {
				var parsedUrl = new URL(url, window.location.href);
				parsedUrl.searchParams.set('lt_form_reload', Date.now().toString());
				return parsedUrl.toString();
			} catch (e) {
				var separator = url.indexOf('?') === -1 ? '?' : '&';
				return url + separator + 'lt_form_reload=' + Date.now();
			}
		}

		ready(function () {
			var modal = document.getElementById('logoModal');
			if (!modal) return;

			var openButtons = document.querySelectorAll('.open-logo-modal');
			var closeButton = modal.querySelector('.close-modal');
			var iframe = modal.querySelector('.logo-form-iframe');
			var lastFocusedElement = null;
			var autoCloseTimer = null;
			var formWasSubmitted = false;

			function iframeContainsSuccessMessage() {
				if (!iframe || !iframe.contentDocument) {
					return false;
				}

				try {
					var doc = iframe.contentDocument;

					var successSelectors = [
						'.ff-message-success',
						'.ff_success_msg',
						'.ff-el-is-success',
						'.ff-form-success',
						'.fluentform .text-success',
						'.fluentform .success',
						'[class*="success"]'
					];

					for (var i = 0; i < successSelectors.length; i++) {
						if (doc.querySelector(successSelectors[i])) {
							return true;
						}
					}

					var bodyText = (doc.body && doc.body.innerText) ? doc.body.innerText : '';

					var successTexts = [
						'Спасибо',
						'отправлены',
						'отправлено',
						'Thank you',
						'submitted',
						'Merci',
						'envoyé',
						'Danke',
						'gesendet',
						'Obrigado',
						'enviado',
						'Gracias',
						'enviado'
					];

					for (var j = 0; j < successTexts.length; j++) {
						if (bodyText.indexOf(successTexts[j]) !== -1) {
							return true;
						}
					}

				} catch (e) {
					return false;
				}

				return false;
			}

			function loadIframeFresh() {
				if (!iframe) return;

				var baseSrc = iframe.getAttribute('data-src');
				if (!baseSrc) return;

				iframe.setAttribute('src', addCacheBuster(baseSrc));
				iframe.setAttribute('data-loaded', '1');
				formWasSubmitted = false;
			}

			function loadIframeOnce() {
				if (!iframe) return;

				var baseSrc = iframe.getAttribute('data-src');
				var currentSrc = iframe.getAttribute('src');

				if (!baseSrc) return;

				/*
				 * Если форма уже была отправлена или внутри iframe осталось сообщение об успехе,
				 * при новом открытии загружаем свежий экземпляр формы.
				 */
				if (formWasSubmitted || iframeContainsSuccessMessage()) {
					loadIframeFresh();
					return;
				}

				if (!currentSrc || currentSrc === 'about:blank') {
					iframe.setAttribute('src', baseSrc);
					iframe.setAttribute('data-loaded', '1');
				}
			}

			function resetIframeAfterSubmit() {
				if (!iframe) return;

				iframe.setAttribute('src', 'about:blank');
				iframe.removeAttribute('data-loaded');
				formWasSubmitted = true;
			}

			function openModal(event) {
				if (event) {
					event.preventDefault();
				}

				lastFocusedElement = document.activeElement;

				loadIframeOnce();

				modal.style.display = 'block';
				modal.classList.add('open');
				modal.setAttribute('aria-hidden', 'false');
				document.body.classList.add('lt-logo-modal-open');

				if (closeButton) {
					closeButton.focus();
				}
			}

			function closeModal(options) {
				options = options || {};

				if (autoCloseTimer) {
					clearTimeout(autoCloseTimer);
					autoCloseTimer = null;
				}

				modal.style.display = 'none';
				modal.classList.remove('open');
				modal.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('lt-logo-modal-open');

				/*
				 * Если форма была отправлена, очищаем iframe.
				 * Это решает проблему старого сообщения:
				 * «Спасибо, логотип и информация отправлены.»
				 */
				if (formWasSubmitted || options.afterSubmit || iframeContainsSuccessMessage()) {
					resetIframeAfterSubmit();
				}

				if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
					lastFocusedElement.focus();
				}
			}

			function handleFormSubmitted() {
				formWasSubmitted = true;

				if (autoCloseTimer) {
					clearTimeout(autoCloseTimer);
				}

				autoCloseTimer = setTimeout(function () {
					closeModal({ afterSubmit: true });
				}, LT_LOGO_MODAL_AUTO_CLOSE_DELAY);
			}

			openButtons.forEach(function (button) {
				button.addEventListener('click', openModal);
			});

			if (closeButton) {
				closeButton.addEventListener('click', function () {
					closeModal();
				});
			}

			modal.addEventListener('click', function (event) {
				if (event.target === modal) {
					closeModal();
				}
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && modal.classList.contains('open')) {
					closeModal();
				}
			});

			window.addEventListener('message', function (event) {
				if (event.origin !== window.location.origin) {
					return;
				}

				if (!event.data || event.data.type !== 'ltLogoFormSubmitted') {
					return;
				}

				handleFormSubmitted();
			});

			/*
			 * Дополнительная страховка:
			 * если iframe уже загружен и сообщение об успехе появилось без postMessage,
			 * проверяем iframe после каждой загрузки.
			 */
			if (iframe) {
				iframe.addEventListener('load', function () {
					setTimeout(function () {
						if (iframeContainsSuccessMessage()) {
							handleFormSubmitted();
						}
					}, 800);
				});
			}
		});
	})();
	</script>

	<div class="wpb_raw_code wpb_raw_js" >
		<div class="wpb_wrapper">
			<script>
(function () {
  'use strict';

  var locale = document.documentElement.lang.trim().toLowerCase().split(/[-_]/)[0];
  var feedbackMessages = {
    ru: ["Подготовка формы…", "Форма не загрузилась. Закройте и откройте её для повторной попытки. Можно написать на info@logo-teka.com."],
    en: ["Preparing the form…", "The form could not be loaded. Close it and open it again to retry, or email info@logo-teka.com."],
    fr: ["Préparation du formulaire…", "Le formulaire n’a pas pu se charger. Fermez-le et rouvrez-le pour réessayer, ou écrivez à info@logo-teka.com."],
    de: ["Das Formular wird vorbereitet…", "Das Formular konnte nicht geladen werden. Schließen und öffnen Sie es erneut oder schreiben Sie an info@logo-teka.com."],
    pt: ["Preparando o formulário…", "Não foi possível carregar o formulário. Feche e abra o formulário novamente ou escreva para info@logo-teka.com."],
    es: ["Preparando el formulario…", "No se pudo cargar el formulario. Ciérralo y vuelve a abrirlo para intentarlo de nuevo o escribe a info@logo-teka.com."]
  };
  var feedbackText = Object.prototype.hasOwnProperty.call(feedbackMessages, locale)
    ? feedbackMessages[locale] : feedbackMessages.en;

  var task = null;
  var ready = false;
  var hideTimer = null;

  function parts() {
    return {
      box: document.getElementById('feedback-form-container'),
      template: document.getElementById('feedback-form-template'),
      mount: document.getElementById('feedback-form-mount'),
      status: document.getElementById('feedback-form-status'),
      button: document.querySelector('.feedback-button')
    };
  }

  function fill(form) {
    form.querySelectorAll('input[name="page-url"]').forEach(function (el) {
      el.value = el.defaultValue = window.location.href;
    });

    form.querySelectorAll('input[name="_wpcf7_ak_js"]').forEach(function (el) {
      el.value = el.defaultValue = String(Date.now());
    });
  }

  function library() {
    return new Promise(function (resolve, reject) {
      var end = Date.now() + 10000;

      function check() {
        if (
          window.wpcf7 &&
          typeof window.wpcf7.init === 'function' &&
          window.wpcf7.api &&
          window.wpcf7.schemas instanceof Map
        ) {
          resolve();
          return;
        }

        if (Date.now() >= end) {
          reject(new Error('CF7 not ready'));
          return;
        }

        setTimeout(check, 100);
      }

      check();
    });
  }

  async function prepare(p) {
    await library();

    var form = p.mount.querySelector('.wpcf7 > form');

    if (!form) {
      p.mount.appendChild(p.template.content.cloneNode(true));
      form = p.mount.querySelector('.wpcf7 > form');

      if (!form) {
        throw new Error('Missing CF7 form');
      }

      form.addEventListener('submit', function (event) {
        if (!ready) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, true);
    }

    fill(form);

    if (!form.wpcf7) {
      window.wpcf7.init(form);
      form.closest('.wpcf7').classList.replace('no-js', 'js');
    }

    var api = window.wpcf7.api;
    var namespace = (api.namespace || 'contact-form-7/v1')
      .replace(/^\/+|\/+$/g, '');

    var endpoint = namespace + '/contact-forms/' +
      form.wpcf7.id + '/feedback/schema';

    var url = new URL(api.root + endpoint, window.location.href);

    if (url.origin !== window.location.origin) {
      throw new Error('Unexpected API origin');
    }

    var abort = new AbortController();
    var timeout = setTimeout(function () {
      abort.abort();
    }, 15000);

    try {
      var response = await fetch(url.href, {
        credentials: 'same-origin',
        headers: {'Accept': 'application/json'},
        signal: abort.signal
      });

      if (!response.ok) {
        throw new Error('Schema HTTP ' + response.status);
      }

      var schema = await response.json();

      if (
        !schema ||
        typeof schema !== 'object' ||
        !Array.isArray(schema.rules)
      ) {
        throw new Error('Invalid CF7 schema');
      }

      window.wpcf7.schemas.set(form.wpcf7.id, schema);
      ready = true;
    } finally {
      clearTimeout(timeout);
    }

    form.addEventListener('reset', function () {
      setTimeout(function () {
        fill(form);
      }, 0);
    });
  }

  window.toggleFeedbackForm = async function () {
    var p = parts();

    if (!p.box || !p.template || !p.mount || !p.status || !p.button) {
      return;
    }

    clearTimeout(hideTimer);

    var opening = p.box.style.display !== 'block';
    p.box.style.display = opening ? 'block' : 'none';
    p.button.setAttribute('aria-expanded', String(opening));

    if (!opening) {
      return;
    }

    var existing = p.mount.querySelector('form');

    if (existing) {
      fill(existing);
    }

    if (ready) {
      return;
    }

    p.status.style.display = 'block';
    p.status.textContent = feedbackText[0];

    if (!task) {
      task = prepare(p);
    }

    try {
      await task;
      p.status.textContent = '';
      p.status.style.display = 'none';
    } catch (error) {
      task = null;

      p.status.textContent = feedbackText[1];

      console.error('LogoTeka feedback:', error);
    }
  };

  document.addEventListener('wpcf7mailsent', function (event) {
    var p = parts();

    if (!p.mount || !p.mount.contains(event.target)) {
      return;
    }

    clearTimeout(hideTimer);

    hideTimer = setTimeout(function () {
      p.box.style.display = 'none';
      p.button.setAttribute('aria-expanded', 'false');
    }, 3000);
  });
})();
</script>
		</div>
	</div>


    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Копирование
        const copyTriggers = document.querySelectorAll('[data-copy-target]');
        copyTriggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const targetId = trigger.getAttribute('data-copy-target');
                const targetElem = document.getElementById(targetId);
                if (targetElem) {
                    navigator.clipboard.writeText(targetElem.innerText).then(() => {
                        trigger.classList.add('copied');
                        setTimeout(() => trigger.classList.remove('copied'), 1000);
                    });
                }
            });
        });

        // Изменение ширины
        const buttons = document.querySelectorAll('.embed-size-btn');
        const codeBlocks = document.querySelectorAll('.logo-embed-text');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                buttons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const width = btn.dataset.width;

                codeBlocks.forEach(block => {
                    const updated = block.innerText.replace(/max-width:\d+px/, 'max-width:' + width + 'px');
                    block.innerText = updated;
                });
            });
        });
    });
    </script>

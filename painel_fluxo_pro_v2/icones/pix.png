</style>
<noscript><style> .wpb_animate_when_almost_visible { opacity: 1; }</style></noscript><style id="lt-source-date-service-style">.w-post-elm.post_custom_field.lt_official_brand_url,
.w-post-elm.post_custom_field.lt_logo_verified_date {
  font-family: inherit;
  font-size: 14px;
  font-weight: inherit;
  line-height: 1.5;
  color: var(--color-content-text, #333333);
  margin-top: 20px;
  margin-bottom: 0;
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}
p:not([style]):not([class]):not([id]) + .w-post-elm.post_custom_field.lt_official_brand_url {
  margin-top: calc(20px - 1.5rem);
}
.w-post-elm.post_custom_field.lt_official_brand_url > .w-post-elm-before,
.w-post-elm.post_custom_field.lt_official_brand_url > a > .w-post-elm-value,
.w-post-elm.post_custom_field.lt_logo_verified_date > .w-post-elm-before,
.w-post-elm.post_custom_field.lt_logo_verified_date > .w-post-elm-value {
  font: inherit;
  color: inherit;
}
.w-post-elm.post_custom_field.lt_official_brand_url + br:has(+ .w-post-elm.post_custom_field.lt_logo_verified_date) {
  display: none;
}
.w-post-elm.post_custom_field.lt_official_brand_url + .w-post-elm.post_custom_field.lt_logo_verified_date,
.w-post-elm.post_custom_field.lt_official_brand_url + br + .w-post-elm.post_custom_field.lt_logo_verified_date {
  margin-top: 4px;
}
.w-post-elm.post_custom_field.lt_official_brand_url > a,
.w-post-elm.post_custom_field.lt_official_brand_url > a:visited {
  font: inherit;
  display: inline;
  color: #165e12 !important;
  text-decoration: none !important;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.12em;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: normal;
}
.w-post-elm.post_custom_field.lt_official_brand_url > a:hover,
.w-post-elm.post_custom_field.lt_official_brand_url > a:focus-visible {
  color: #10480d !important;
}
.w-post-elm.post_custom_field.lt_official_brand_url > a:focus-visible {
  outline: 2px solid currentColor !important;
  outline-offset: 2px;
}

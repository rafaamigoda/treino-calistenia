	<div class="wpb_raw_code wpb_raw_html wpb_content_element us_custom_909b2fd0" >
		<div class="wpb_wrapper">
			    <style>
      @media (max-width: 600px) {
        .l-section.rekl-vert-size:has([data-lt-upper-ad]:not([data-layout="desktop"])),
        .l-section.rekl-vert-size.lt-upper-mobile {
          min-height: 0;
        }
        .rekl-vert-size [data-lt-upper-ad]:not([data-layout="desktop"]) {
          box-sizing: border-box;
          height: 100px;
          width: 100%;
        }
        .rekl-vert-size [data-lt-upper-ad]:not([data-layout="desktop"]) > :first-child {
          width: 100%;
          height: 100px;
          max-height: 100px;
        }
        .l-section.rekl-vert-size.lt-upper-empty {
          display: none;
        }
      }
    </style>
    <div id="lt-upper-ad-1" data-lt-upper-ad data-network="adsense"></div>
    <script>
      (() => {
        const slot = document.getElementById('lt-upper-ad-1');
        if (!slot || slot.dataset.requested) return;
        const row = slot.closest('.l-section.rekl-vert-size');
        const mobile = Boolean(row && matchMedia('(max-width: 600px)').matches);
        slot.dataset.layout = mobile ? 'mobile' : 'desktop';
        const mark = (state) => {
          slot.dataset.adState = state;
          if (state === 'unfilled' && mobile && row.getBoundingClientRect().top >= innerHeight) {
            row.classList.add('lt-upper-empty');
          }
        };
        slot.dataset.requested = '1';
        mark('loading');
        if (mobile) row.classList.add('lt-upper-mobile');

        if (slot.dataset.network === 'rsya') {
          const target = document.createElement('div');
          target.id = 'promo-16325756-1';
          slot.append(target);
          window.yaContextCb = window.yaContextCb || [];
          window.yaContextCb.push(() => {
            const options = {blockId: mobile ? 'R-A-16325756-4' : 'R-A-16325756-1', renderTo: target.id, pageLang: 'ru'};
            if (!mobile) {
              Ya.Context.AdvManager.render(options);
              return;
            }
            options.onRender = () => mark('filled');
            options.onError = (data) => {
              if (data.type === 'error') mark('error');
            };
            Ya.Context.AdvManager.render(options, () => mark('unfilled'));
          });
          return;
        }

        slot.classList.add('lt-adsense');
        const ad = document.createElement('ins');
        ad.className = 'adsbygoogle';
        ad.style.display = 'block';
        ad.dataset.adClient = 'ca-pub-0144682968424290';
        ad.dataset.adSlot = mobile ? '6217585565' : '1307332830';
        if (mobile) {
          ad.style.width = '100%';
          ad.style.height = '100px';
          ad.dataset.fullWidthResponsive = 'false';
          const observer = new MutationObserver(() => {
            const state = ad.getAttribute('data-ad-status');
            if (['filled', 'unfilled', 'unfill-optimized'].includes(state)) {
              mark(state);
              observer.disconnect();
            }
          });
          observer.observe(ad, {attributes: true, attributeFilter: ['data-ad-status']});
        } else {
          ad.dataset.adFormat = 'auto';
          ad.dataset.fullWidthResponsive = 'true';
        }
        slot.append(ad);
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (error) {
          mark('error');
          throw error;
        }
      })();
    </script>
    
